* This file sets up the reimagine client side pricing namespace.\n */\nif (!window.reimagine) {\n  window.reimagine = {};\n}\nif (!window.reimagine.CSP) {\n  window.reimagine.CSP = {};\n}\nif (!window.reimagine.CSP.Module) {\n  window.reimagine.CSP.Module = {};\n}\nif (!window.reimagine.CSP.Instance) {\n  window.reimagine.CSP.Instance = {};\n}\n/**\n * Constants for Skagit Reimagine CSP.\n */\nwindow.reimagine.CSP.Module.Constants = {\n  attributes: {\n    cspRequest: 'data-rds-csp',\n    cspContent: 'data-rds-csp-content'\n  },\n  events:{\n    cpsRefreshed: 'CSPRefreshed',\n    cspRefresh: 'CSPRefresh',\n    cspHardRefresh: 'CSPHardRefresh'\n  },\n  logging: {\n    tag: '[Reimagine][CSP]'\n  }\n}\n\n/**\n * Process handler base class for process handlers to extend. This class\n * provides base functionality for caching responses, provides a way to track requests, \n * and provides a process function to override.\n */\nwindow.reimagine.CSP.Module.ProcessHandlerBase = class ProcessHandlerBase {\n\n  constructor(type) {\n\n    // Prevent direct instantiation of abstract base class.\n    if (new.target === ProcessHandlerBase) {\n      throw new Error('ProcessHandlerBase is an abstract class and cannot be instantiated directly. Please extend it instead.');\n    }\n    \n    this.type = type; // The process type used for tagging pricing elements.\n    this.cache = {}; // Process response cache.\n    this.abortControllers = []; // Abort controllers for handling canceling requests.\n  }\n\n  /**\n   * Clears the process cache.\n   */\n  clearCache() {\n    this.cache = {};\n  }\n  \n  /**\n   * OVERRIDE THIS IN EXTENDING CLASSES.\n   * This function,\n   * 1. Takes a list of request items [{requestData, target, element}]\n   * 2. Takes a list of pricing content key-value pairs.\n   * 3. Applies the web component specific render data as a target attribute to the element.\n   */\n  async process(requestItems, pricingContent) {\n    throw new Error('process() must be implemented by subclass');\n  }\n};\n\n/**\n * Commercial process class for handling mapping from request items to render data\n * using the commercial data connector.\n */\nwindow.reimagine.CSP.Module.CommercialProcessHandler = class CommercialProcessHandler extends window.reimagine.CSP.Module.ProcessHandlerBase {\n\n  // Response codes.\n  SUCCESS = 'Success';\n  NOT_FOUND = 'NotFound';\n  NOT_AVAILABLE = 'NoAvailableSku';\n  DISABLED_MARKET = 'DisabledMarket';\n\n  constructor() {\n    super(\"commercial\");\n    this._batchSize = 5; // Number of queries per batch.\n    this.requestRetries = 3; // Number of failed request retires.\n    this.locale = window.reimagine.utils.getPageLocale();\n  }\n\n  /**\n   * Processes request items and adds the target attribute render data.\n   * @param requestItems - An array of request items.\n   * @param pricingContent - A map of pricing content.\n   */\n  async process(requestItems, pricingContent) {\n\n    // Build render data for already cached queries.\n    this._buildRenderData(requestItems, pricingContent);\n\n    // Get unique request query request item groups.\n    const uniqueRequestQueryGroups = this._getUniqueRequestQueryGroups(requestItems);\n\n    // Fetch, cache, and update request item elements using data from the data connector.\n    await this._fetchPricingData(uniqueRequestQueryGroups);\n  }\n\n  /**\n   * Creates a map of unique request queries to request items list.\n   * @param requestItems - An array of request items.\n   * @returns - A map of unique request queries to request items list.\n   */\n  _getUniqueRequestQueryGroups(requestItems) {\n    const uniqueRequestQueryGroups = {};\n    requestItems.forEach(item => {\n      const query = item.requestData.requestQuery;\n      if (query) {\n        if (!uniqueRequestQueryGroups[query]) {\n          uniqueRequestQueryGroups[query] = [];\n        }\n        uniqueRequestQueryGroups[query].push(item);\n      }\n    });\n    return uniqueRequestQueryGroups;\n  }\n   \n  /**\n   * Fetches pricing data from the data connector, caches responses, and updates request item elements.\n   * @param uniqueRequestQueryGroups - A map of unique request queries to request items list.\n   */\n  async _fetchPricingData(uniqueRequestQueryGroups) {\n    \n    // Cancel all previous requests.\n    this._cancelActiveRequests();\n    \n    // Add an abort controller to keep track of requests.\n    const controller = new AbortController();\n    this.abortControllers.push(controller);\n\n    // Fetch uncached query batches.\n    const batches = this._getUncachedBatches(uniqueRequestQueryGroups);\n    batches.forEach(batchItem => {\n      this._fetchWithRetry(async () => {\n        \n        // Fetch the batch data.\n        const dataArray = await this._fetchBatch(batchItem, controller.signal);\n        this._cacheResponses(dataArray);\n\n        // Build the render data for the group after the response.\n        batchItem.forEach(([_, requestItems]) => {\n          this._buildRenderData(requestItems);\n        });\n      }, this._requestRetries)\n      .catch((err) => {\n        if (err.name != 'AbortError') {\n          console.warn(`Pricing request batch failed.`);\n        }\n      });\n    });\n  }\n\n  /**\n   * Cancels all ongoing requests.\n   */\n  _cancelActiveRequests() {\n    this.abortControllers.forEach(controller => controller.abort());\n    this.abortControllers = [];\n  }\n\n  /**\n   * Builds an array of query request groups for uncached queries.\n   * @param uniqueRequestQueryGroups - A set of unique request queries.\n   * @returns - An array of batches of uncached query groups.\n   */  \n  _getUncachedBatches(uniqueRequestQueryGroups) {\n    \n    const batches = [];\n    const entries = Object.entries(uniqueRequestQueryGroups);\n    for (let i = 0; i < entries.length; i += this._batchSize) {\n      const batch = entries\n        .slice(i, i + this._batchSize)\n        .filter(([queryKey]) => !this.cache[queryKey]); // Use key for cache check\n\n      if (batch.length > 0) {\n        batches.push(batch);\n      }\n    }\n\n    return batches;\n  }\n\n  /**\n   * Retries fetch requests.\n   * @param fn - Function to call\n   * @param retries - Number of retries\n   * @param delay - Delay between retries\n   */\n  async _fetchWithRetry(fn, retries = 3, delay = 500) {\n    for (let attempt = 1; attempt <= retries; attempt++) {\n      try {\n        return await fn();\n      } catch (err) {\n        // Stop retrying if the request is canceled or out of attempts. \n        if (attempt === retries || err.name === 'AbortError') throw err;\n        await new Promise(res => setTimeout(res, delay));\n      }\n    }\n  }\n  \n  /**\n   * Fetches pricing data from the data connector given a batch of queries.\n   * @param batch - Batch to fetch.\n   * @returns - Data connector response.\n   */\n  async _fetchBatch(batch, signal) {\n    const combinedQuery = batch.map((batchItem) => encodeURIComponent(batchItem[0])).join('%2C');\n    const endpoint =  window.reimagine.utils.getDataConnectorEndpoint('/m365/product/price', `v=4&r=json&llcc=${this.locale}&q=${combinedQuery}`);\n    const response = await fetch(endpoint, {signal});\n    return response.json();\n  }\n\n  /**\n   * Caches response data by unique query.\n   * @param responseData - Response data from the data connector. \n   */\n  _cacheResponses(responseData) {\n    responseData.forEach(item => {\n      const query = item.puid;\n      this.cache[query] = item;\n    });\n  }\n\n  /**\n   * Builds render data from request and cached response data.\n   * @param requestItems - A list of request items.\n   * @param pricingContent - A map of pricing content.\n   */\n  _buildRenderData(requestItems, pricingContent) {\n\n    requestItems.forEach((item) => {\n      const requestData = item.requestData;\n      const responseData = this.cache[requestData.requestQuery];\n      if (!responseData || !requestData) return;\n\n      // Normalize the pricing data that is used for building render data.\n      const normalizedData = this._normalizePricingData(requestData, responseData, pricingContent);\n\n      // Set the target attribute.\n      item.elem.setAttribute(item.target, JSON.stringify(normalizedData))\n    });\n  }\n\n  /**\n   * Normalizes request data and response data into a single pricing data object for reference\n   * when building the render data object. This is required because some render data is provided\n   * as part of the request and only renders based on response data.\n   * @param requestData - Request data.\n   * @param responseData - Data connector response data.\n   * @param pricingContent - A map of pricing content.\n   * @returns - Normalized pricing data.\n   */\n  _normalizePricingData(requestData, responseData, pricingContent) {\n\n    const responseCode = responseData.responseCode;\n    let normalizedData = {};\n\n    // Disabled market.\n    if (responseCode == this.DISABLED_MARKET) {\n      normalizedData[requestData.titleKey || 'title'] = responseData.title;\n      normalizedData[requestData.unavailableTextKey || 'unavailableText'] = \n        pricingContent['embargo-message'];\n      return normalizedData;\n    } \n    \n    // Not found or not available.\n    if (responseCode != this.SUCCESS) {\n      normalizedData[requestData.unavailableTextKey || 'unavailableText'] = \n        pricingContent['unavailable-message'];\n      return normalizedData;\n    } \n\n    const sku = responseData.sku;\n\n    // Title.\n    let normalizedTitle = requestData.titleOverride ? \n      requestData.titleOverride :\n      requestData.isUsingProductTitle ? \n        responseData.title : sku.title;\n    normalizedData[requestData.titleKey || 'title'] = normalizedTitle;\n\n    // Is discounted\n    normalizedData[requestData.isDiscountedKey || 'isDiscounted'] = sku.msrpPrice != sku.listPrice;\n    \n    // Current Price, MSRP, and discount.\n    normalizedData[requestData.currentPriceKey || 'currentPrice'] = sku.displayListPrice;\n    normalizedData[requestData.discountKey || 'discount'] = sku.displayDiscountPrice;\n    normalizedData[requestData.msrpPriceKey || 'msrpPrice'] = sku.displayMSRPPrice;\n\n    return normalizedData;\n  }\n};\n/**\n * Process service class to handle registering processes, querying pricing elements,\n * processing elements by handler groups, and clearing all process caches.\n */\nwindow.reimagine.CSP.Module.ProcessService = class ProcessService {\n\n  /**\n   * Component Service constructor.\n   * @param {CSP.Module.Constants} constants - CSP constants.\n   */\n  constructor(constants) {\n    this._constants = constants;\n    this._handlers = {};\n  }\n\n  /**\n   * Registers a component type handler.'\n   * @param handlerInstance - Instance of a class that extends ProcessHandlerBase.\n   */\n  registerHandler(handlerInstance) {\n    this._handlers[handlerInstance.type] = handlerInstance;\n  }\n\n  /**\n   * Clears all handlers cache.\n   */\n  clearAllHandlerCache() {\n    Object.values(this._handlers).forEach(handler => {\n      if (handler && typeof handler.clearCache === 'function') {\n        handler.clearCache();\n      }\n    });\n  }\n\n  /**\n   * Processes pricing component elements with corresponding handlers.\n   */\n  processElements() {\n    \n    // Query all pricing components.\n    const componentElems = this._queryPricingComponents()\n\n    // Iterate over all pricing components and group by handler type.\n    let elemProcessGroups = this._groupByHandlerType(componentElems);\n\n    // Process the grouped elements with registered handlers.\n    this._processElemGroups(elemProcessGroups);\n  }\n\n  /**\n   * Queries all pricing component elements on the page.\n   * @returns - An array of pricing component elements.\n   */\n  _queryPricingComponents() {\n    return document.querySelectorAll(`[${this._constants.attributes.cspRequest}]`);\n  }\n\n  /**\n   * Builds a content map from the CSP content element. Each attribute on the element is parsed\n   * as a key-value pair in the content map where the key is the attribute name without the prefix\n   * and the value is the attribute value.\n   * @returns - A map grouped by pricing group.\n   */\n  _buildContentMap() {\n    const contentElem = document.querySelector(`[${this._constants.attributes.cspContent}]`);\n    const contentMap = {};\n    if (contentElem) {\n      Array.from(contentElem.attributes).forEach(attr => {\n        const attrNameParts = attr.name.split('-');\n        if (attrNameParts.length < 2 || attrNameParts[0] == 'data') return;\n        const groupKey = attrNameParts[0];\n        if (!contentMap[groupKey]) {\n          contentMap[groupKey] = {};\n        }\n        const contentKey = attrNameParts.slice(1).join('-');\n        contentMap[groupKey][contentKey] = attr.value;\n      });\n    }\n    return contentMap;\n  }\n\n  /**\n   * Groups elements by handler type.\n   * @param componentElems - Array of component elements.\n   * @returns - A map of data and element pairs by handler type.\n   */\n  _groupByHandlerType(componentElems) {\n    \n    let groups = {};\n    componentElems.forEach((elem) => {\n\n      try {\n        // Get the request data from the element.\n        const encodedCSPRequestData = elem.getAttribute(this._constants.attributes.cspRequest);\n        const cspRequestData = JSON.parse(decodeURIComponent(encodedCSPRequestData.replace(/\\+/g, ' ')));\n\n        // Slot the element into groups by handler type.\n        if (!groups[cspRequestData.type]) {\n          groups[cspRequestData.type] = [];\n        }\n        groups[cspRequestData.type].push({ \n          requestData: cspRequestData.data,\n          target: cspRequestData.target, \n          elem: elem\n        });\n      } catch (e) {\n        console.warn(`${this._constants.logging.tag} - ${elem} does not have valid request json.`);\n      }\n    });\n\n    return groups;\n  }\n\n  /**\n   * Processes component element groups with corresponding handlers.\n   * @param groups - Map of component element groups by process. \n   */\n  _processElemGroups(groups) {\n\n    let pricingContent = this._buildContentMap();\n\n    // Iterate over the groups.\n    Object.keys(groups).forEach(async (type) => {\n      const handler = this._handlers[type];\n      if (handler) {\n\n        // Process the groups with the corresponding handler.\n        handler.process(groups[type], pricingContent[type] || {});\n      }\n    });\n  }\n\n  _\n};\n/**\n * Event manager class for listening for CSP events and dispatching \n * a custom CSP complete event.\n */\nwindow.reimagine.CSP.Module.EventManager = class EventManager {\n\n  /**\n   * Event manager constructor\n   * @param {CSP.Module.ProcessService} processService- Component utils.\n   * @param {CSP.Module.Constants} constants - CSP constants.\n   */\n  constructor(processService, constants) {\n    this._processService = processService;\n    this._constants = constants;\n    this._bindEventHandlers();\n    this._listenForEvents();\n  }\n\n  /**\n   * Binds this to event handlers.\n   */\n  _bindEventHandlers() {\n    this._refreshPricing = this._refreshPricing.bind(this);\n    this._hardRefreshPricing = this._hardRefreshPricing.bind(this);\n  }\n\n  /**\n   * Listens for events and calls event handlers.\n   */\n  _listenForEvents() {\n\n    if (!this._constants) return;\n\n    // Listen for page load event.\n    document.readyState == 'loading' ? \n      document.addEventListener('DOMContentLoaded', this._refreshPricing) :\n      this._refreshPricing();\n\n    // CSP refresh event\n    document.addEventListener(this._constants.events.cspRefresh, () => {this._refreshPricing()});\n\n    // CSP hard refresh event.\n    document.addEventListener(this._constants.events.cspHardRefresh, () => {this._hardRefreshPricing()});\n  }\n\n  /**\n   * Refreshes all pricing components with cached or new pricing data.\n   */\n  async _refreshPricing() {\n    if (!this._processService) return;\n    this._processService.processElements();\n    this._dispatchPricingRefreshedEvent();\n  }\n\n  /**\n   * Refreshes all pricing components with new pricing data.\n   */\n  async _hardRefreshPricing() {\n    if (!this._processService) return;\n    this._processService.clearAllHandlerCache();\n    this._refreshPricing();\n  }\n\n  /**\n   * Dispatches a custom event to alert that CSP has refreshed prices.\n   */\n  _dispatchPricingRefreshedEvent() {\n    document.dispatchEvent(new CustomEvent(this._constants.events.pricingRefreshed));\n  }\n};\n/**\n * This file initializes the client side pricing services, handlers & managers with dependencies.\n */\n(() => {\n\n  // Services.\n  const processService = new window.reimagine.CSP.Module.ProcessService(\n    window.reimagine.CSP.Module.Constants\n  );\n\n  // Handlers.\n  processService.registerHandler(new window.reimagine.CSP.Module.CommercialProcessHandler());\n\n  // Managers.\n  const eventManager = new window.reimagine.CSP.Module.EventManager(\n    processService, \n    window.reimagine.CSP.Module.Constants\n  );\n\n  // CSP Instance.\n  window.reimagine.CSP.Instance = {\n    eventManager: eventManager,\n    processService: processService\n  }\n})();"},"headersSize":0,"bodySize":5093,"redirectURL":"","_transferSize":5093},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":38.429,"receive":185.752},"_resourceType":"script","serverIPAddress":"6.6.0.93","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"www.microsoft.com","issuer":"Microsoft TLS G2 RSA CA OCSP 04","validFrom":1769111721,"validTo":1800215721}},{"pageref":"page@40e64a78bc45ae8a9ec90546f8629457","startedDateTime":"2026-08-26T23:56:43.989Z","time":240.54399999999998,"request":{"method":"GET","url":"https://www.microsoft.com/echo/etc.clientlibs/microsoft/components/structure/page/clientlibs/embed-thirdparty.ACSHASH27de1aa1215463b126ed9a49430c4872.min.js","httpVersion":"HTTP/2.0","cookies":[{"name":"CAS_PROGRAM"