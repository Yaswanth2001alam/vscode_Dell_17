c addEnvironmentSpecificQueryParams = (url) => {\n    let envQueryParamKeys = Object.keys(\n      window.reimagine.env.DataConnector.queryParams\n    );\n    envQueryParamKeys.forEach((key) => {\n      if (url.indexOf(\"?\") !== -1) url += \"&\";\n      url += `${key}=${window.reimagine.env.DataConnector.queryParams[key]}`;\n    });\n    return url;\n  };\n\n  /**\n   * Gets the current page locale.\n   * @returns {string} - The page locale or en-us as default.\n   */\n  static getPageLocale() {\n    const REIMAGINE_LOCALE_META = 'reimagine-locale';\n    const localeMeta = document.querySelector(`[${REIMAGINE_LOCALE_META}]`);\n    if (localeMeta) {\n      return localeMeta.getAttribute(REIMAGINE_LOCALE_META);\n    }\n    return 'en-us';\n  }\n}"},"headersSize":0,"bodySize":1110,"redirectURL":"","_transferSize":1110},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":37.58,"receive":185.007},"_resourceType":"script","serverIPAddress":"6.6.0.93","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"www.microsoft.com","issuer":"Microsoft TLS G2 RSA CA OCSP 04","validFrom":1769111721,"validTo":1800215721}},{"pageref":"page@40e64a78bc45ae8a9ec90546f8629457","startedDateTime":"2026-08-26T23:56:43.989Z","time":226.07600000000002,"request":{"method":"GET","url":"https://www.microsoft.com/echo/etc.clientlibs/store/clientlibs/clientlib-reimagine-telemetry.ACSHASH75700fee831fecc12a43889e71860361.min.js","httpVersion":"HTTP/2.0","cookies":[{"name":"CAS_PROGRAM","value":"echo"},{"name":"ak_bmsc","value":"4EFD07C1807C998F748FBD99BB206B33~000000000000000000000000000000~"}],"headers":[{"name":":authority","value":"www.microsoft.com"},{"name":":method","value":"GET"},{"name":":path","value":"/echo/etc.clientlibs/store/clientlibs/clientlib-reimagine-telemetry.ACSHASH75700fee831fecc12a43889e71860361.min.js"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"acce