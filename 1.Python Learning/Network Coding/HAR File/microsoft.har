 document.querySelector(layoutContainerSelector);\n    const uhfSkipToMain = document.querySelector(uhfSelector);\n    const acomHeaderSkipToMain = document.querySelector(acomSelector);\n    const skipLinkElement = uhfSkipToMain || acomHeaderSkipToMain;\n    \n    if (!skipLinkElement || !layoutContainer) {\n      // Either no skip link or no layout container found, no need to continue.\n      return;\n    }\n    \n    let targetId = uhfSkipToMain ? defaultContentId : defaultAcomContentId;\n    const layoutContainerId = layoutContainer?.getAttribute(\"id\");\n    const skipLinkAttribute = skipLinkElement.hasAttribute(\"data-href\") ? \"data-href\" : \"href\";\n    \n    const skipLinkHref = skipLinkElement.getAttribute(skipLinkAttribute)?.split(\"#\").pop(); // Get the part after the '#' if it exists.\n    if (skipLinkHref) {\n      targetId = skipLinkHref;\n    } else if (layoutContainerId) {\n      targetId = layoutContainerId;\n    }\n    skipLinkElement.setAttribute(skipLinkAttribute, `#${targetId}`);\n    layoutContainer.setAttribute(\"id\", targetId);\n  };\n\n  // Apply the layout container ID on page load.\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', applyUhfLayoutContainerId);\n  } else {\n    applyUhfLayoutContainerId();\n  }\n})(document);\n"},"headersSize":0,"bodySize":1154,"redirectURL":"","_transferSize":1154},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":47.84,"receive":189.961},"_resourceType":"script","serverIPAddress":"6.6.0.93","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"www.microsoft.com","issuer":"Microsoft TLS G2 RSA CA OCSP 04","validFrom":1769111721,"validTo":1800215721}},{"pageref":"page@40e64a78bc45ae8a9ec90546f8629457","startedDateTime":"2026-08-26T23:56:43.990Z","time":241.8,"request":{"method":"GET","url":"https://www.microsoft.com/msonecloudapi/assets/reimaginesharedbody.js","httpVersion":"HTTP/2.0","cookies":[{"name":"CAS_PROGRAM","va