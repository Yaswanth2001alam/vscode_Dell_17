:"sec-ch-ua-platform","value":"\"Windows\""},{"name":"sec-ch-ua-platform-version","value":"\"19.0.0\""},{"name":"sec-fetch-dest","value":"script"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36"}],"queryString":[],"headersSize":1369,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"accept-ch","value":"Sec-CH-UA-Platform-Version"},{"name":"accept-ranges","value":"bytes"},{"name":"cache-control","value":"public, max-age=2340732"},{"name":"content-encoding","value":"gzip"},{"name":"content-length","value":"544"},{"name":"content-type","value":"application/javascript;charset=utf-8"},{"name":"date","value":"Wed, 26 Aug 2026 23:56:44 GMT"},{"name":"last-modified","value":"Mon, 24 Aug 2026 02:08:56 GMT"},{"name":"ms-commit-id","value":"dd25caa"},{"name":"ms-cv","value":"CASMicrosoftCV1572a1c9.0"},{"name":"ms-cv-esi","value":"CASMicrosoftCV1572a1c9.0"},{"name":"strict-transport-security","value":"max-age=31557600"},{"name":"tls_version","value":"tls1.3"},{"name":"vary","value":"Accept-Encoding"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-edgescape-location","value":"country_code=US"},{"name":"x-frame-options","value":"SAMEORIGIN"},{"name":"x-rtag","value":"etc_echo_cookieless"},{"name":"x-served-by","value":"cache-bfi-kbfi7400060-BFI"},{"name":"x-timer","value":"S1787537336.167465,VS0,VS0,VE41"},{"name":"x-vhost","value":"publish_echo-microsoft_s"}],"content":{"size":1233,"mimeType":"application/javascript;charset=utf-8","compression":220,"text":"\n/**\n * @file update-oneds.js\n * Update 1ds telemetry elements after <dynamic-price> pulls in the price data\n * \n * @eventhandler DYNAMIC-PRICE-UPDATED\n * Event name is set in dynamic-price web component\n * \n * Depends on the heading of the AEM component to have the class \"component-heading\"\n */\n\n    document?.addEventListener(\"DYNAMIC-PRICE-UPDATED\", function (e) {\n        if (!e.detail?.priceText) return;\n\n        setTimeout(() => {\n            const $cta = $(e.target.closest('.link-group>*'));\n            const priceText = $cta.get(0)?.textContent?.replaceAll(/(\\s)+/g, ' ');\n            if (!$cta.length) return;\n            if (priceText) {\n                ['data-bi-cn', 'data-bi-ecn'].forEach(tag => {\n                    if ($cta.data('originalText')?.includes('dynamic-price'))\n                        $cta.attr(tag, priceText);\n                });\n            }\n            const heading = $cta.closest('[data-componentname], .card').find('.component-heading').get(0)?.textContent?.replaceAll(/(\\s)+/g, ' ');\n            ['data-bi-hn', 'data-bi-ehn'].forEach(tag => {\n                if ($cta.attr(tag)?.includes('dynamic-price'))\n                    $cta.attr(tag, heading);\n            });\n        }, 1500);\n    });"},"headersSize":0,"bodySize":1013,"redirectURL":"","_transferSize":1013},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":22.63,"receive":175.68},"_resourceType":"script","serverIPAddress":"6.6.0.93","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"www.microsoft.com","issuer":"Microsoft TLS G2 RSA CA OCSP 04","validFrom":1769111721,"validTo":1800215721}},{"pageref":"page@40e64a78bc45ae8a9ec90546f8629457","startedDateTime":"2026-08-26T23:56:43.975Z","time":60.673,"request":{"method":"GET","url":"https://www.microsoft.com/echo/etc.clientlibs/store/clientlibs/clientlib-web-components/link/v1.ACSHASH077a53bd6a78f40ab68f080cdefa02c1.min.js","httpVersion":"HTTP/2.0","cookies":[{"name":"CAS_PROGRAM","value":"echo"},{"name":"ak_bmsc","value":"4EFD07C1807C998F748FBD99BB206B33~000000000000000000000000000000~"}],"headers":[{"name":":authority","value":"www.microsoft.com"},{"name":":method","value":"GET"},{"name":":path","value":"/echo/etc.clientlibs