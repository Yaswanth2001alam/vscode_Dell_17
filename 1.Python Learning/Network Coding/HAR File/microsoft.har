ion\",cancelButtonText:\"Cancel\"},c={title:\"Store Assistant\",chatIconAlt:\"Chat\",menuButtonArialLabel:\"Menu\",expandChatAriaLabel:\"Expand\",minimizeButtonAriaLabel:\"Minimize\",closeButtonAriaLabel:\"Close\",createRestartMessage:\"Let's start over\",warningIconLabel:\"Warning\",endButtonText:\"End\",suggestedPromptsLabel:\"Suggested prompts\",starRatingLabel:\"Star rating\",dataTableLabel:\"Data table\",endChatConversationLabel:\"End chat conversation\",noDataAvailable:\"No data available\",starButtonLabelPlural:\"{0} stars\",starButtonLabelSingular:\"1 star\"},u={welcomeMessage:\"Hi, I'm a Store Assistant powered by AI. I can help you with shopping and support. I can also connect you with a Microsoft Sales Associate. What can I do for you?\",disclaimerMessage:\"Store Assistant is powered by AI, so surprises and mistakes are possible.\",termsOfUseText:\"Terms of use\",termsOfUseLink:\"https://www.microsoft.com/en-us/servicesagreement/\",privacyText:\"Privacy\",privacyLink:\"https://www.microsoft.com/en-KE/privacy/privacystatement\",faqText:\"FAQ\",faqLink:\"https://support.microsoft.com/en-KE/account-billing/faqs-for-store-assistant-376f1013-bf45-45e2-80d8-8f17a069b5a6\",loadingMessage:\"Generating...\",timeoutMessage:\"Your conversation has timed out due to inactivity.\\nThe chat history above will not be included in the next chat session.\",retryMessage:\"Try again\",waitingMessage:\"Waiting...\",chatMessage:\"Chat with a Microsoft Sales Associate\",phoneCallMessage:\"Phone Call with a Microsoft Store Associate.\",connectedAIMessage:\"You are connected\",handleConnectWithAgent:\"Please hold while we confirm the availability of a Microsoft Associate...\",handleAgentUnavailable:\"Microsoft Associate is not available at the moment. Please try again later.\",feedbackSubmittedMessage:\"Your feedback has been submitted at\",closedMessage:\"Conversation closed by AI at\",connectedLiveAgentMessage:\"You are connected to\",closeLiveAgentMessage:\"Conversation with Microsoft Associate closed by agent at\",startLiveAgentMessageBegin:\"Conversation with Microsoft Associate\",startLiveAgentMessageEnd:\"started at\"},d={pleaseHoldMessage:\"Please hold while we connect you with a Microsoft Associate...\",connectedMessage:\"You are now connected to an agent\",queuePositionFormat:\"Estimated wait time is {waitTime}, You are {position} in line\",cancelButtonText:\"Cancel\",canceledButtonText:\"Canceled\",minuteSingular:\"minute\",minutePlural:\"minutes\"},g={textAreaAriaLabel:\"Type a message\",newButtonAriaLabel:\"Start a new conversation\",placeholderValue:\"How can we help you?\",charRemainingMessagePlural:\"${remaining} characters remaining out of ${textAreaMaxLength}\",charRemainingMessageSingular:\"${remaining} character remaining out of ${textAreaMaxLength}\"},p={chatExpertLabel:\"Chat with an Expert\",chatLabel:\"Chat with Sales Associate\",feedbackLabel:\"Send feedback\",callUsLabel:\"Call us\",newTopicLabel:\"New Topic\",endChatLabel:\"End Chat Session\",supportLabel:\"Support Menu\",supportAriaLabel:\"Support Menu options\"},f={seeMore:\"See more\",seeLess:\"See less\",retryMessage:\"Try again\"},m={clearState:\"\",connectedSuccessfully:\"Connected to agent successfully\",characterLimitExceeded:\"Character limit exceeded\",connectAttempt:\"Attempting to connect to agent and checking their availability\",generatingResponse:\"Generating response\",receivedResponse:\"Received response from Store Assistant\",errorResponse:\"Error generating response\",startNewConversationMessage:\"Start new Conversation\",canceledConnectionToAgent:\"You canceled connecting to an agent at\",unableToCancelAgentConnection:\"Unable to cancel agent connection. Please try again.\",estimatedWaitTime:\" Estimated wait time is\",youAreText:\" You are \",inLineText:\" in line\",agentDisconnected:\"Agent has left the conversation\"},h={commentQuestion:\"Please tell us more. Why did you choose that answer?\",promptQuestion:\"We have two questions for you.\",