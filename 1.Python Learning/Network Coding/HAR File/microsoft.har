Text:\"Chat now\"},r={veryDissatisfied:\"Very dissatisfied\",somewhatDissatisfied:\"Somewhat dissatisfied\",neutral:\"Neither satisfied nor dissatisfied\",somewhatSatisfied:\"Somewhat satisfied\",verySatisfied:\"Very satisfied\",defaultLabel:\"Select a star\",submitButtonText:\"Submit\",ratingDisplayFormat:\"Rating: {rating} {starWord}\",starSingular:\"star\",starPlural:\"stars\"},o={userCloseConvMessage:\"Conversation closed by you at \",aiCloseConvMessage:\"Conversation closed by AI at \",chatHistoryErrorNote:\"The chat history above will not be included in the next chat session\",genericError:\"Something went wrong. Please try sending your message again.\",genericErrorWithDetails:\"Something went wrong:\",createConvError:\"Something went wrong and it appears Chat is not operational. Please try closing and reopening the chat. Otherwise, please try another support method.\",agentUnavailableError:\"Unfortunately, a Microsoft Store Associate isn't available right now. Please try again in a few minutes.\"},i={surveyMessage:\"We'd love your feedback. If you have a moment to answer a few questions, please select the button below.\",takeSurvey:\"Take short survey\"},s=\"Need Help? Lets Chat\",l={message:\"Do you want to end this conversation and start over?\",title:\"End conversation\",confirmButtonText:\"End conversation\",cancelButtonText:\"Cancel\"},c={title:\"Store Assistant\",chatIconAlt:\"Chat\",menuButtonArialLabel:\"Menu\",expandChatAriaLabel:\"Expand\",minimizeButtonAriaLabel:\"Minimize\",closeButtonAriaLabel:\"Close\",createRestartMessage:\"Let's start over\",warningIconLabel:\"Warning\",endButtonText:\"End\",suggestedPromptsLabel:\"Suggested prompts\",starRatingLabel:\"Star rating\",dataTableLabel:\"Data table\",endChatConversationLabel:\"End chat conversation\",noDataAvailable:\"No data available\",starButtonLabelPlural:\"{0} stars\",starButtonLabelSingular:\"1 star\"},u={welcomeMessage:\"Hi, I'm a Store Assistant powered by AI. I can help you with shopping a