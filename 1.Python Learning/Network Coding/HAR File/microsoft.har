\\t\\twindow.uetq.push('event','buildyourbundle', tempobj); \\n\\t\\t});\\n\\t\\t\\t\\n\\t\\t\\n\\t\\t// check your eligibility CTA\\n\\t\\t\\n\\t\\t$(document).on('mousedown',\\\"a[href*='student-discounts?successurl']\\\",'', function() {\\n\\t\\t\\twindow.uetq.push('event','checkeligibility', tempobj); \\n\\t\\t});\\n      \\n      \\t// Add to Cart button, particularly needed for Surface Go PDP\\n\\t\\t$(document).on('mousedown','button[id*=\\\"buttons_AddToCartButton\\\"]','', function() {\\n\\t\\t\\twindow.uetq.push('event','addtocartbutton', tempobj); \\n\\t\\t});\\t\\t\\n\\t}\\n} catch(bingerr) {console.log(\\\"bing onclick err\\\");}\\n\",language:\"javascript\"}}]},{id:\"RLac6a616fe35c4532b607e5131e2a10fe\",name:\"BoostSurfacePDPs\",events:[{modulePath:\"core/src/lib/events/pageBottom.js\",settings:{},ruleOrder:50}],conditions:[{modulePath:\"core/src/lib/conditions/path.js\",settings:{paths:[{value:\"/en-us/d/\",valueIsRegex:!0},{value:\"/en-us/store/configure/\",valueIsRegex:!0},{value:\"/en-us/store/collections/microsoftsurfacedeals\",valueIsRegex:!0},{value:\"/en-us/store/b/surface-deals\",valueIsRegex:!0}]}}],actions:[{modulePath:\"core/src/lib/actions/customCode.js\",settings:{source:\"var pdpLinks = 'a[href*=\\\"/en-us/d/\\\"]';\\nvar configuratorLinks = 'a[href*=\\\"/en-us/store/configure/\\\"]';\\nvar buttons = 'button';\\n\\nfunction attachPixels(selector) {\\n  // Checks if current page is PDP or Configurator\\n    function isPDPorConfiguratorPage() {\\n        var path = window.location.pathname.toLowerCase();\\n        return path.startsWith(\\\"/en-us/d/\\\") || path.startsWith(\\\"/en-us/store/configure/\\\");\\n    }\\n  \\n  // Gets label to send to UE\\n    function getEventLabel() {\\n        if (window._TMDL) {\\n            if (_TMDL.path && _TMDL.path.includes(\\\"/store/configure/\\\")) {\\n                var parts = _TMDL.path.split('/');\\n                return parts.length > 4 ? parts[4] : _TMDL.pageName || window.location.pathname;\\n            }\\n            if (Array.isArray(_TMDL.pids) && _TMDL.pids.length > 0) {\\n                return _TMDL.pids[0];\\n            }\\n            if (_TMDL.pageName) {\\n                return _TMDL.pageName;\\n            }\\n        }\\n        return window.location.pathname;\\n    }\\n    \\n  // Attach tracking based on selector type and page\\n  $(document).on('mousedown', selector, function (e) {\\n    var target = $(e.currentTarget);\\n    var href = target.attr('href') || target.closest('a').attr('href') || '';\\n    \\n    if (isPDPorConfiguratorPage()) {\\n            // Track ALL clicks when on PDP or Configurator\\n            window.uetq_Amplify = window.uetq_Amplify || [];\\n            window.uetq_Amplify.push('event', 'click', { 'event_label': getEventLabel() });\\n    } else {\\n      // For links: track only clicks that navigate to PDP or Configurator pages\\n      if (href.includes(\\\"/en-us/d/\\\") || href.includes(\\\"/en-us/store/configure/\\\")) {\\n        window.uetq_Amplify = window.uetq_Amplify || [];\\n        window.uetq_Amplify.push('event', 'click', { 'event_label': getEventLabel() });\\n      }\\n    }\\n  });\\n}\\n\\ntry {\\n    (function (w, d, t, r, u) {\\n        var f, n, i; w[u] = w[u] || [], f = function () {\\n            var o = { ti: \\\"149014572\\\" }; o.q = w[u], w[u] = new UET(o), w[u].push(\\\"pageLoad\\\")\\n        },\\n            n = d.createElement(t), n.src = r, n.async = 1,\\n            n.onload = n.onreadystatechange = function () {\\n                var s = this.readyState; s && s !== \\\"loaded\\\" && s !== \\\"complete\\\" || (f(), n.onload = n.onreadystatechange = null)\\n            }, i = d.getElementsByTagName(t)[0], i.parentNode.insertBefore(n, i)\\n    })(window, document, \\\"script\\\", \\\"//bat.bing.com/bat.js\\\", \\\"uetq_Amplify\\\");\\n\\n    attachPixels(pdpLinks);\\n    attachPixels(configuratorLinks);\\n    attachPixels(buttons);\\n}\\ncatch (err) {\\n    _satellite.logger.error(\\\"Boost Surface PDP\\\");\\n}\",language:\"javascript\"}}]},{id:\"RLacbd6ba054124b0b937d3caf5aa646df\",name:\"TikTok AddtoCart Publicis\",events:[{modulePath:\"core/src/lib/events/pageBottom.js\",settings:{},ruleOrder:50}],conditions:[{modulePath:\"core/src/lib/conditions/dateRange.js\",settings:{end:\"2027-06-30T00:00:00Z\",start:\"2026-06-01T00:00:00Z\"}},{modulePath:\"core/src/lib/conditions/path.js\",settings:{paths:[{value:\"/(en-(us|gb|au|ca)|ja-jp|de-de|fr-ca|fr-fr)/store/configure/.*surface\",valueIsRegex:!0}]}}],actions:[{modulePath:\"core/src/lib/actions/customCode.js\",settings:{source:'try {\\n    var firstConfig = \\'a[href*=\"/store/configure\"]\\';\\n    var secondConfig = \\'button[data-action*=\"Configure\"]\\';\\n    var addToCart = \\'button[data-automation-test-id*=\"checkout-button\"]\\';\\n\\n    attachPixels(firstConfig);\\n    attachPixels(secondConfig);\\n    attachPixels(addToCart);\\n}\\ncatch (err) {\\n    _satellite.logger.error(\"TikTok Initiate Checkout Failed\", err);\\n}\\n\\nfunction attachPixels(elementAddress) {\\n    $(document).on(\\'mousedown\\', elementAddress, function () {\\n\\n        // Get TikTok Click ID\\n        var ttclid = _satellite.getVar(\"ttclid\");\\n\\n        // Generate unique event ID\\n        var rand = Math.floor(Math.random() * 90000) + 10000;\\n        var eventId = Date.now().toString() + rand.toString();\\n\\n        // Build TikTok pixel URL\\n        var tiktokPixelUrl = \"https://analytics.tiktok.com/api/v2/pixel_event_track?pixel_code=D8FKQ1BC77UDLID65MNG&event=InitiateCheckout&event_id=\" + eventId;\\n\\n        // Append ttclid if available\\n        if (ttclid) {\\n            tiktokPixelUrl += \"&ttclid=\" + encodeURIComponent(ttclid);\\n        }\\n\\n        // Fire TikTok pixel\\n        var tiktokPixel = new Image(1, 1);\\n        tiktokPixel.src = tiktokPixelUrl;\\n    });\\n}\\n',language:\"javascript\"}}]},{id:\"RLafca8ec24b594c8e8d900f5fd9373a36\",name:\"VRZN_LP_Srfc\",events: