sparent;padding:.5rem 1rem;cursor:pointer}\n.cmp-tabs__tab--active{border-color:inherit}\n.cmp-tabs__tabpanel{display:none}\n.cmp-tabs__tabpanel--active{display:block}"},"headersSize":0,"bodySize":646,"redirectURL":"","_transferSize":646},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":39.504,"receive":193.107},"_resourceType":"stylesheet","serverIPAddress":"6.6.0.93","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"www.microsoft.com","issuer":"Microsoft TLS G2 RSA CA OCSP 04","validFrom":1769111721,"validTo":1800215721}},{"pageref":"page@40e64a78bc45ae8a9ec90546f8629457","startedDateTime":"2026-08-26T23:56:43.975Z","time":62.396,"request":{"method":"GET","url":"https://www.microsoft.com/echo/etc.clientlibs/store/clientlibs/clientlib-web-components/pill/v1.ACSHASH797afaf372ffee0b7b4322a1cfcf8762.min.js","httpVersion":"HTTP/2.0","cookies":[{"name":"CAS_PROGRAM","value":"echo"},{"name":"ak_bmsc","value":"4EFD07C1807C998F748FBD99BB206B33~000000000000000000000000000000~"}],"headers":[{"name":":authority","value":"www.microsoft.com"},{"name":":method","value":"GET"},{"name":":path","value":"/echo/etc.clientlibs/store/clientlibs/clientlib-web-components/pill/v1.ACSHASH797afaf372ffee0b7b4322a1cfcf8762.min.js"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"en-US,en;q=0.9"},{"name":"cookie","value":"CAS_PROGRAM=echo; ak_bmsc=4EFD07C1807C998F748FBD99BB206B33~000000000000000000000000000000~"},{"name":"origin","value":"https://www.microsoft.com"},{"name":"priority","value":"u=1"},{"name":"referer","value":"https://www.microsoft.com/en-us"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"151\", \"Not=A?Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"sec-ch-ua-platform-version","value":"\"19.0.0\""},{"name":"sec-fetch-dest","value":"script"},{"name":"sec-fetch-mode","value":"cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36"}],"queryString":[],"headersSize":1347,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"accept-ch","value":"Sec-CH-UA-Platform-Version"},{"name":"accept-ranges","value":"bytes"},{"name":"cache-control","value":"public, max-age=2051854"},{"name":"content-encoding","value":"gzip"},{"name":"content-length","value":"116"},{"name":"content-type","value":"application/javascript;charset=utf-8"},{"name":"date","value":"Wed, 26 Aug 2026 23:56:44 GMT"},{"name":"last-modified","value":"Thu, 20 Aug 2026 17:54:18 GMT"},{"name":"ms-commit-id","value":"dd25caa"},{"name":"ms-cv","value":"CASMicrosoftCV1572a086.0"},{"name":"ms-cv-esi","value":"CASMicrosoftCV1572a086.0"},{"name":"strict-transport-security","value":"max-age=31557600"},{"name":"tls_version","value":"tls1.3"},{"name":"vary","value":"Accept-Encoding"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-edgescape-location","value":"country_code=US"},{"name":"x-frame-options","value":"SAMEORIGIN"},{"name":"x-rtag","value":"etc_echo_cookieless"},{"name":"x-served-by","value":"cache-bfi-kbfi7400089-BFI"},{"name":"x-timer","value":"S1787248466.113919,VS0,VS0,VE3"},{"name":"x-vhost","value":"publish_echo-microsoft_s"}],"content":{"size":140,"mimeType":"application/javascript;charset=utf-8","compression":0,"text":"import '/etc.clientlibs/store/clientlibs/clientlib-web-components/reimagine-resources/resources/js/latest/components/pill/index-v1.37.0.js';"},"headersSize":0,"bodySize":584,"redirectURL":"","_transferSize":584},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":49.58,"receive":12.816},"_resourceType":"script","serverIPAddress":"6.6.0.93","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"www.microsoft.com","issuer":"Microsoft TLS G2 RSA CA OCSP 04","validFrom":1769111721,"validTo":1800215721}},{"pageref":"page@40e64a78bc45ae8a9ec90546f8629457","startedDateTime":"2026-08-26T23:56:43.975Z","time":274.06399999999996,"request":{"method":"GET","url":"https://www.microsoft.com/echo/etc.clientlibs/microsoft/components/content/chatonpage/v1/chatonpage/clientlibs/site.ACSHASH2fb2ee7e38d60e8d94c57f9825ac077c.min.js","httpVersion":"HTTP/2.0","cookies":[{"name":"CAS_PROGRAM","value":"echo"},{"name":"ak_bmsc","value":"4EFD07C1807C998F748FBD99BB206B33~000000000000000000000000000000~"}],"headers":[{"name":":authority","value":"www.microsoft.com"},{"name":":method","value":"GET"},{"name":":path","value":"/echo/etc.clientlibs/microsoft/components/content/chatonpage/v1/chatonpage/clientlibs/site.ACSHASH2fb2ee7e38d60e8d94c57f9825ac077c.min.js"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"en-US,en;q=0.9"},{"name":"cookie","value":"CAS_PROGRAM=echo; ak_bmsc=4EFD07C1807C998F748FBD99BB206B33~000000000000000000000000000000~"},{"name":"priority","value":"u=2"},{"name":"referer","value":"https://www.microsoft.com/en-us"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"151\", \"Not=A?Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"sec-ch-ua-platform-version","value":"\"19.0.0\""},{"name":"sec-fetch-dest","value":"script"},{"name":"sec-fetch-mode","value":"no-cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36"}],"queryString":[],"headersSize":1355,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"accept-ch","value":"Sec-CH-UA-Platform-Version"},{"name":"accept-ranges","value":"bytes"},{"name":"cache-control","value":"public, max-age=2340765"},{"name":"content-encoding","value":"gzip"},{"name":"content-length","value":"4272"},{"name":"content-type","value":"application/javascript;charset=utf-8"},{"name":"date","value":"Wed, 26 Aug 2026 23:56:44 GMT"},{"name":"last-modified","value":"Mon, 24 Aug 2026 02:09:29 GMT"},{"name":"ms-commit-id","value":"dd25caa"},{"name":"ms-cv","value":"CASMicrosoftCV1572a208.0"},{"name":"ms-cv-esi","value":"CASMicrosoftCV1572a208.0"},{"name":"strict-transport-security","value":"max-age=31557600"},{"name":"tls_version","value":"tls1.3"},{"name":"vary","value":"Accept-Encoding"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-edgescape-location","value":"country_code=US"},{"name":"x-frame-options","value":"SAMEORIGIN"},{"name":"x-rtag","value":"etc_echo_cookieless"},{"name":"x-served-by","value":"cache-bfi-kbfi7400060-BFI"},{"name":"x-timer","value":"S1787537369.325923,VS0,VS0,VE16"},{"name":"x-vhost","value":"publish_echo-microsoft_s"}],"content":{"size":20496,"mimeType":"application/javascript;charset=utf-8","compression":15755,"text":"(function () {\n    \"use strict\";\n\n    const CONFIG = {\n        selectors: {\n            component: \".msstore-chatonpage\",\n            textInput: \".msstore-chatonpage__text-input\",\n            submitButton: \".msstore-chatonpage__submit-button\",\n            promptPill: \".msstore-chatonpage__prompt-pill\"\n        },\n        retryDelay: 500,\n        maxRetries: 10\n    };\n\n    // Global state to prevent button mashing\n    let isCurrentlySending = false;\n\n    /**\n     * Helper function to get the AEM Component API with retry logic\n     * @returns {Promise<Object>} The AEM Component API object\n     */\n    function waitForStoreAssistantChatAPI() {\n        return new Promise((resolve, reject) => {\n            let attempts = 0;\n            \n            function checkAPI() {\n                if (window.storeAssistantReactJsLib?.chat) {\n                    resolve(window.storeAssistantReactJsLib.chat);\n                    return;\n                }\n                \n                attempts++;\n                if (attempts >= CONFIG.maxRetries) {\n                    reject(new Error(`AEM Component API not available after ${CONFIG.maxRetries} attempts`));\n                    return;\n                }\n                \n                setTimeout(checkAPI, CONFIG.retryDelay);\n            }\n            \n            checkAPI();\n        });\n    }\n\n    /**\n     * Test function to force open chat - can be called from console for debugging\n     */\n    window.forceOpenChat = async function() {\n        try {\n            const api = await waitForStoreAssistantChatAPI();\n            const result = await api.openChat();\n            return result;\n        } catch (error) {\n            console.error('Error forcing chat open:', error);\n        }\n    };\n\n    /**\n     * Send a prompt using the AEM Component API with proper error handling\n     * @param {string} message - The message to send\n     * @returns {Promise<boolean>} Success status\n     */\n    async function sendPromptViaAPI(message) {\n        try {\n            // Global sending state protection\n            if (isCurrentlySending) {\n                return false;\n            }\n\n            const api = await waitForStoreAssistantChatAPI();\n            \n            // Set global sending flag\n            isCurrentlySending = true;\n            \n            try {\n                // Step 1: Check current state\n                const isCurrentlyMinimized = await api.isMinimized();\n                \n                // Step 2: Always ensure chat is open\n                const openResult = await api.openChat();\n                \n                // Step 3: Double-check and maximize if still minimized\n                const isStillMinimized = await api.isMinimized();\n                \n                if (isStillMinimized) {\n                    const maxResult = await api.maximizeChat();\n                    \n                    // Final verification\n                    const finalState = await api.isMinimized();\n                }\n                \n                // Step 4: Send the prompt\n                const sendResult = await api.sendPrompt(message);\n\n                return sendResult;\n            } finally {\n                // Always reset the sending flag after a delay to ensure UI updates\n                setTimeout(() => {\n                    isCurrentlySending = false;\n                }, 1000);\n            }\n        } catch (error) {\n            console.error(\"Error using AEM Component API:\", error);\n            isCurrentlySending = false;\n            return false;\n        }\n    }\n\n    /**\n     * Initialize chat components on the page\n     */\n    async function initChatOnPage() {\n        const chatComponents = document.querySelectorAll(CONFIG.selectors.component);\n\n        if (!chatComponents.length) {\n            console.warn(\"Chat on page component not found on page\");\n            return;\n        }\n\n        chatComponents.forEach(component => {\n            const actionType = component.getAttribute(\"data-action-type\");\n\n            if (actionType === \"textInputOnly\" || actionType === \"hybridInputAndPills\") {\n                initTextInputChat(component);\n            }\n\n            if (actionType === \"promptPillsOnly\" || actionType === \"hybridInputAndPills\") {\n                initPromptPillsChat(component);\n            }\n        });\n\n        // Initialize the chat through the API if available\n        try {\n            const api = await waitForStoreAssistantChatAPI();\n            if (api.initChatOnPage) {\n                await api.initChatOnPage();\n            }\n        } catch (error) {\n            console.error(\"Error initializing chat via API:\", error);\n        }\n    }\n\n    /**\n     * Update submit button state based on input content\n     * @param {HTMLInputElement} textInput - The text input element\n     * @param {HTMLButtonElement} submitButton - The submit button element\n     */\n    function updateSubmitButtonState(textInput, submitButton) {\n        const hasContent = textInput.value.trim().length > 0;\n        \n        if (hasContent) {\n            submitButton.classList.add(\"active\");\n            submitButton.disabled = false;\n        } else {\n            submitButton.classList.remove(\"active\");\n            submitButton.disabled = true;\n        }\n    }\n\n    /**\n     * Initialize text input functionality for a chat component\n     * @param {Element} component - The chat component element\n     */\n    function initTextInputChat(component) {\n        const submitButton = component.querySelector(CONFIG.selectors.submitButton);\n        const textInput = component.querySelector(CONFIG.selectors.textInput);\n\n        if (submitButton && textInput) {\n            // Initialize button state\n            updateSubmitButtonState(textInput, submitButton);\n\n            // Update button state on input\n            textInput.addEventListener(\"input\", function() {\n                updateSubmitButtonState(textInput, submitButton);\n            });\n\n            // Update button state on paste\n            textInput.addEventListener(\"paste\", function() {\n                setTimeout(() => {\n                    updateSubmitButtonState(textInput, submitButton);\n                }, 0);\n            });\n\n            submitButton.addEventListener(\"click\", function(event) {\n                event.preventDefault();\n                if (!submitButton.disabled) {\n                    handleTextSubmission(textInput, submitButton);\n                }\n            });\n\n            textInput.addEventListener(\"keypress\", function(event) {\n                if (event.key === \"Enter\") {\n                    event.preventDefault();\n                    if (!submitButton.disabled) {\n                        handleTextSubmission(textInput, submitButton);\n                    }\n                }\n            });\n        }\n    }\n\n    /**\n     * Initialize prompt pill functionality for a chat component with button mashing protection\n     * @param {Element} component - The chat component element\n     */\n    function initPromptPillsChat(component) {\n        const promptPills = component.querySelectorAll(CONFIG.selectors.promptPill);\n\n        promptPills.forEach(pill => {\n            // Set initial styles from data attributes\n            const restColor = pill.getAttribute(\"data-rest-color\");\n            const restTextColor = pill.getAttribute(\"data-rest-text-color\");\n            const restIconColor = pill.getAttribute(\"data-rest-icon-color\");\n            const restStrokeColor = pill.getAttribute(\"data-rest-stroke-color\");\n            const pressedColor = pill.getAttribute(\"data-pressed-color\");\n            const pressedTextColor = pill.getAttribute(\"data-pressed-text-color\");\n            const pressedIconColor = pill.getAttribute(\"data-pressed-icon-color\");\n            const pressedStrokeColor = pill.getAttribute(\"data-pressed-stroke-color\");\n            const hoverColor = pill.getAttribute(\"data-hover-color\");\n            const hoverTextColor = pill.getAttribute(\"data-hover-text-color\");\n            const hoverIconColor = pill.getAttribute(\"data-hover-icon-color\");\n            const hoverStrokeColor = pill.getAttribute(\"data-hover-stroke-color\");\n            const svgIconPath = pill.querySelector(\"svg path\");\n\n            // Add hover effect for background color if hoverColor is set\n            if (hoverColor || hoverTextColor || hoverIconColor || hoverStrokeColor) {\n                pill.addEventListener(\"mouseenter\", function() {\n                    pill.style.background = hoverColor || \"\";\n                    pill.style.color = hoverTextColor || \"\";\n                    if (svgIconPath) svgIconPath.style.fill = hoverIconColor || \"\";\n                    pill.style.borderColor = hoverStrokeColor || \"\";\n                });\n                pill.addEventListener(\"mouseleave\", function() {\n                    // Restore to original background color or pressed color if active\n                    pill.style.background = pill.classList.contains(\"active\") && pressedColor\n                        ? pressedColor\n                        : (restColor || \"\");\n                    pill.style.color = pill.classList.contains(\"active\") && pressedTextColor\n                        ? pressedTextColor\n                        : (restTextColor || \"\");\n                    if (svgIconPath) {\n                        svgIconPath.style.fill = pill.classList.contains(\"active\") && pressedIconColor\n                            ? pressedIconColor\n                            : (restIconColor || \"\");\n                    }\n                    pill.style.borderColor = pill.classList.contains(\"active\") && pressedStrokeColor\n                        ? pressedStrokeColor\n                        : (restStrokeColor || \"\");\n                });\n            }\n\n            // Set initial styles if provided\n            pill.style.background = restColor || \"\";\n            pill.style.color = restTextColor || \"\";\n            if (svgIconPath) svgIconPath.style.fill = restIconColor || \"\";\n            pill.style.borderColor = restStrokeColor || \"\";\n\n            pill.addEventListener(\"click\", function() {\n                // Prevent rapid clicking/button mashing at the UI level\n                if (isCurrentlySending) {\n                    return;\n                }\n\n                const message = pill.getAttribute(\"data-pill-value\");\n\n                // Visual feedback\n                promptPills.forEach(p => {\n                    p.classList.remove(\"active\");\n                    pill.style.background = restColor || \"\";\n                    pill.style.color = restTextColor || \"\";\n                    if (svgIconPath) svgIconPath.style.fill = restIconColor || \"\";\n                    pill.style.borderColor = restStrokeColor || \"\";\n                });\n                pill.classList.add(\"active\");\n                // Set pressed color only when active, otherwise revert to default\n                pill.style.background = pill.classList.contains(\"active\") && pressedColor\n                    ? pressedColor\n                    : (restColor || \"\");\n                pill.style.color = pill.classList.contains(\"active\") && pressedTextColor\n                    ? pressedTextColor\n                    : (restTextColor || \"\");\n                if (svgIconPath) svgIconPath.style.fill = pill.classList.contains(\"active\") && pressedIconColor\n                    ? pressedIconColor\n                    : (restIconColor || \"\");\n                pill.style.borderColor = pill.classList.contains(\"active\") && pressedStrokeColor\n                    ? pressedStrokeColor\n                    : (restStrokeColor || \"\");\n\n                if (message) {\n                    sendPromptViaAPI(message)\n                        .then(success => {\n                            setTimeout(() => {\n                                pill.classList.remove(\"active\");\n                                // Restore background color after sending\n                                pill.style.background = restColor || \"\";\n                                pill.style.color = restTextColor || \"\";\n                                if (svgIconPath) svgIconPath.style.fill = restIconColor || \"\";\n                                pill.style.borderColor = restStrokeColor || \"\";\n                            }, 2000);\n                        })\n                        .catch(error => {\n                            console.error(\"Error sending prompt pill message:\", error);\n                            pill.classList.remove(\"active\");\n                        });\n                }\n            });\n        });\n    }\n\n    /**\n     * Handle text input submission with button mashing protection\n     * @param {HTMLInputElement} textInput - The text input element\n     * @param {HTMLButtonElement} submitButton - The submit button element\n     */\n    function handleTextSubmission(textInput, submitButton) {\n        // Prevent rapid submission\n        if (isCurrentlySending) {\n            return;\n        }\n\n        const message = textInput.value.trim();\n\n        if (message) {\n            const originalMessage = message;\n            textInput.value = \"\";\n\n            // Update button state after clearing input\n            updateSubmitButtonState(textInput, submitButton);\n\n            sendPromptViaAPI(originalMessage)\n                .then(success => {\n                    console.log(\"Text message result:\", success);\n                })\n                .catch(error => {\n                    console.error(\"Error sending text message:\", error);\n                    // Restore the input if sending failed\n                    textInput.value = originalMessage;\n                    // Update button state after restoring input\n                    updateSubmitButtonState(textInput, submitButton);\n                });\n        }\n    }\n\n    // Initialize when DOM is ready\n    if (document.readyState === \"loading\") {\n        document.addEventListener(\"DOMContentLoaded\", initChatOnPage);\n    } else {\n        initChatOnPage();\n    }\n\n    // Listen for store assistant related events\n    window.addEventListener(\"msChatScriptsLoaded\", function() {\n        setTimeout(initChatOnPage, 500);\n    });\n\n    const storeAssistantEvents = [\"StoreAssistantLoaded\", \"StoreAssistantReady\", \"StoreAssistantInitialized\"];\n    storeAssistantEvents.forEach(eventName => {\n        window.addEventListener(eventName, function() {\n            setTimeout(initChatOnPage, 500);\n        });\n    });\n\n    // Observe DOM for relevant changes to reinitialize when needed\n    const observer = new MutationObserver(function(mutations) {\n        for (const mutation of mutations) {\n            if (mutation.addedNodes && mutation.addedNodes.length > 0) {\n                for (const node of mutation.addedNodes) {\n                    if (node.nodeType === Node.ELEMENT_NODE &&\n                        (node.id === \"msChatContainer\" ||\n                         node.id === \"storeassistantroot\" ||\n                         node.classList.contains(\"copilot-container\") ||\n                         node.classList.contains(\"sa-default-entry-container\"))) {\n                        setTimeout(initChatOnPage, 500);\n                        return;\n                    }\n                }\n            }\n        }\n    });\n\n    document.addEventListener(\"DOMContentLoaded\", function () {\n          const input = document.querySelector(\".js-ghost-input\");\n          const ghostData = document.querySelector(\".js-ghost-rotation-data\");\n          if (!input || !ghostData) return;\n\n          const data = [...ghostData.querySelectorAll(\"li\")].map(li => li.textContent);\n          if (!data) return;\n          const ghostTexts = data.map(t => t.trim()).filter(Boolean);\n          if (ghostTexts.length === 0) return;\n\n          // Read the animate flag, default to true\n          const animateGhostText = ghostData.getAttribute(\"data-animate-ghost-text\") !== \"false\";\n\n          let index = 0;\n          let intervalId = null;\n          let timeoutId = null;\n          let isAnimatingGhost = false;\n          let currentAnimationToken = null;\n\n          /**\n           * Check if a given animation token is still valid\n           */\n          function isTokenValid(token) {\n              return currentAnimationToken === token;\n          }\n\n          /**\n           * Typing animation for ghost text\n           * Types out the text character by character, then clears it\n           */\n          async function typeGhostText(text, token) {\n              return new Promise((resolve) => {\n                  let charIndex = 0;\n                  const typingSpeed = 50; // milliseconds per character\n                  const displayDuration = 1500; // how long to display the full text\n\n                  function typeCharacter() {\n                      // Check if this animation run is still valid\n                      if (!isTokenValid(token)) return;\n\n                      if (charIndex < text.length) {\n                          input.setAttribute(\"placeholder\", text.substring(0, charIndex + 1));\n                          charIndex++;\n                          timeoutId = setTimeout(typeCharacter, typingSpeed);\n                      } else {\n                          // Text is fully typed, wait before clearing\n                          timeoutId = setTimeout(clearText, displayDuration);\n                      }\n                  }\n\n                  function clearText() {\n                      // Check if this animation run is still valid\n                      if (!isTokenValid(token)) return;\n\n                      if (charIndex > 0) {\n                          charIndex--;\n                          input.setAttribute(\"placeholder\", text.substring(0, charIndex));\n                          timeoutId = setTimeout(clearText, 30); // faster clearing\n                      } else {\n                          // Text is fully cleared, move to next text\n                          index = (index + 1) % ghostTexts.length;\n                          resolve();\n                      }\n                  }\n\n                  if (isTokenValid(token)) {\n                      typeCharacter();\n                  }\n              });\n          }\n\n          function setGhostPlaceholder() {\n              input.setAttribute(\"placeholder\", ghostTexts[index]);\n              index = (index + 1) % ghostTexts.length;\n          }\n\n          async function startGhostAnimation() {\n              // Prevent re-entry if animation is already running\n              if (isAnimatingGhost) {\n                  return;\n              }\n\n              isAnimatingGhost = true;\n\n              // Clear any existing interval from previous animation runs\n              if (intervalId) {\n                  clearInterval(intervalId);\n                  intervalId = null;\n              }\n\n              // Create a unique token for this animation run\n              const token = {};\n              currentAnimationToken = token;\n\n              try {\n                  if (animateGhostText) {\n                      // Use typing animation with cancellation checks in the loop\n                      while (isAnimatingGhost && isTokenValid(token)) {\n                          await typeGhostText(ghostTexts[index], token);\n                      }\n                  } else {\n                      // Use simple rotation (original behavior)\n                      if (isAnimatingGhost) {\n                          setGhostPlaceholder();\n                          intervalId = setInterval(setGhostPlaceholder, 3000);\n                      }\n                  }\n              } finally {\n                  // Ensure the flag is reset when animation ends or is cancelled\n                  isAnimatingGhost = false;\n              }\n          }\n\n          function stopGhostAnimation() {\n              isAnimatingGhost = false;\n              currentAnimationToken = null; // Invalidate the token to stop all pending timeouts\n              if (intervalId) {\n                  clearInterval(intervalId);\n                  intervalId = null;\n              }\n              if (timeoutId) {\n                  clearTimeout(timeoutId);\n                  timeoutId = null;\n              }\n              input.setAttribute(\"placeholder\", \"\");\n          }\n\n          input.addEventListener(\"focus\", stopGhostAnimation);\n          input.addEventListener(\"blur\", startGhostAnimation);\n\n          startGhostAnimation();\n\n           \n         });\n\n\n    observer.observe(document.body, {\n        childList: true,\n        subtree: true\n    });\n\n})();"},"headersSize":0,"bodySize":4741,"redirectURL":"","_transferSize":4741},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":80.636,"receive":193.428},"_resourceType":"script","serverIPAddress":"6.6.0.93","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"www.microsoft.com","issuer":"Microsoft TLS G2 RSA CA OCSP 04","validFrom":1769111721,"validTo":1800215721}},{"pageref":"page@40e64a78bc45ae8a9ec90546f8629457","startedDateTime":"2026-08-26T23:56:43.976Z","time":233.269,"request":{"method":"GET","url":"https://www.microsoft.com/echo/etc.clientlibs/microsoft/components/content/chatonpage/v1/chatonpage/clientlibs/site.ACSHASH1c0ebe66f9bec616088058bf722d3339.min.css","httpVersion":"HTTP/2.0","cookies":[{"name":"CAS_PROGRAM","value":"echo"},{"name":"ak_bmsc","value":"4EFD07C1807C998F748FBD99BB206B33~000000000000000000000000000000~"}],"headers":[{"name":":authority","value":"www.microsoft.com"},{"name":":method","value":"GET"},{"name":":path","value":"/echo/etc.clientlibs/microsoft/components/content/chatonpage/v1/chatonpage/clientlibs/site.ACSHASH1c0ebe66f9bec616088058bf722d3339.min.css"},{"name":":scheme","value":"https"},{"name":"accept","value":"text/css,*/*;q=0.1"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"en-US,en;q=0.9"},{"name":"cookie","value":"CAS_PROGRAM=echo; ak_bmsc=4EFD07C1807C998F748FBD99BB206B33~000000000000000000000000000000~"},{"name":"priority","value":"u=2"},{"name":"referer","value":"https://www.microsoft.com/en-us"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"151\", \"Not=A?Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value