d6f7c1e391\">\n\n\n\n\n\n\n  \n  \n\n  \n\n  \n  \n\n  <store-announcement english-label=\"Classes start soon—sign in and save up to 10% on select Surface and more for students.\" aria-label=\"Announcement banner\" fill-color=\"#0072C6\" text-color=\"#ffffff\" close-title=\"Close\" close-label=\"Close\" theme=\"night\" sr-close-text=\"Close\" data-oc=\"oc493d\" id=\"announcement-oc493d\">\n    \n\n    \n      \n\n    \n    \n\n    \n\n    <p slot=\"announcement__label\">\n      \n  \n    \n    \n<link rel=\"stylesheet\" href=\"/echo/etc.clientlibs/microsoft/components/content/dynamic-price/v1/dynamic-price/clientlibs/sites.ACSHASH21a62deda101598fd74a61798e99114e.min.css\" type=\"text/css\">\n<script src=\"/echo/etc.clientlibs/microsoft/components/content/dynamic-price/v1/dynamic-price/clientlibs/sites.ACSHASHa26d031bf8c00f082570666bfff25659.min.js\"></script>\n\n\n\n  \n\n\t\n    \n\t\t\n\t\t\n\t\t\t\n\t\t\n\n    \n    \n      \n\n      \n        Classes start soon—sign in and save up to 10% on select Surface and more for students.\n      \n    \n\t\n\n  \n\n    </p>\n  \n    \n    \n      \n      \n        \n\n\n\n    \n\n\n\n\n\n  \n\n  \n  \n\n  \n  \n\n  \n\n  \n\n  \n  \n    \n  \n<script src=\"/echo/etc.clientlibs/store/clientlibs/clientlib-web-components/link/v1.ACSHASH077a53bd6a78f40ab68f080cdefa02c1.min.js\" type=\"module\"></script>\n\n\n\n  \n\n  \n  \n  \n\n  <store-link slot=\"announcement__link\" configuration=\"default\" media-position=\"left\" data-bi-bhvr=\"0\" data-bi-tags=\"{}\" enCtatext=\"Shop now\" title=\"Shop now\" link-label=\"Back to school is here—students save 10% on select Surface and more.\" data-oc=\"oca3af\" id=\"action-oca3af\">\n\n    \n      \n      \n\n  \n  \n  <a href=\"https://www.microsoft.com/en-us/store/b/education?icid=mscom_marcom_TS1a_BTS27\" target=\"_self\">\n    \n    \n\n    \n\n    \n      Shop now\n    \n\n\n  </a>\n\n    \n\n    \n  </store-link>\n\n\n  \n  \n    \n    \n<script src=\"/echo/etc.clientlibs/cascade.component.authoring/clientlibs/clientlib-site.ACSHASHa567686753af50a244e7587f9b688a45.min.js\"></script>\n<script src=\"/echo/etc.clientlibs/store/components/content/reimagine/foundational/action/v1/action/clientlib/site.ACSHASH319be30bf70cf1a150e8493f9464d7d1.min.js\"></script>\n\n\n\n  \n\n\n      \n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n\n\n    \n  </store-announcement>\n\n  \n    \n  \n<script src=\"/echo/etc.clientlibs/store/clientlibs/clientlib-web-components/announcement/v1.ACSHASH028ed9cc49359aa6ace9954acee24875.min.js\" type=\"module\"></script>\n\n\n\n  \n\n</div>\n<div class=\"featured tabs panelcontainer aem-GridColumn aem-GridColumn--default--12\" data-component-id=\"29710086fcdd3366caca03daf4f66b57\">\n\n\n\n\n\n\n\n\n  \n  \n\n  \n  \n\n  <store-featured top-layout-configuration=\"1-col-even\" top-breadth=\"compact\" data-oc=\"oc88c9\" breadth=\"compact\" density=\"none\" bottom-breadth=\"compact\" theme=\"day\" id=\"featured-oc88c9\" fill-color=\"#FFF9F5\">\n\n    \n    \n\n    \n  \n  \n    \n    \n      \n\n  \n    \n\n\n\n\n\n  \n  \n\n  \n  \n    \n  \n<script src=\"/echo/etc.clientlibs/store/clientlibs/clientlib-web-components/media/v1.ACSHASH49cdd757c100966c21a71137d608aa95.min.js\" type=\"module\"></script>\n\n\n\n  \n\n  \n  \n\n  \n  \n    <store-media slot=\"ui-shell-media\" data-oc=\"oc7dd2\" id=\"media-oc7dd2\">\n\n        \n          \n          \n            \n\n\n  \n    \n\n\n  \n\n\n\n\n \n\n  \n      \n      \n      \n    \n    \n        <img src=\"https://cdn-dynmedia-1.microsoft.com/is/image/microsoftcorp/MSCOM-FY26-Evergreen-Hero-Light-Background-Desktop?resMode=sharp2&op_usm=1.5,0.65,15,0&wid=1920&hei=2150&qlt=80&fit=constrain\" class=\"   \" alt loading=\"lazy\" slot=\"media__asset\" data-oc=\"oc8041\" id=\"reimagine-image-oc8041\"/>\n    \n\n  \n\n          \n        \n\n        \n\n        \n          \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n    </store-media>\n\n    \n  \n\n\n    \n\n   <store-layout-column slot=\"ui-shell-header\">\n    \n      \n        \n\n\n\n\n\n  \n  \n\n  \n  \n\n  \n\n    <store-heading-block animation-duration=\"medium-1\" animation-view=\"load\" animation-enter=\"slide-in-bottom\" data-oc=\"oc0db3\" animation-delay=\"delay-0\" id=\"heading-block-oc0db3\" animation-iteration=\"1\" data-en-title=\"Hi there, welcome to Microsoft\" size=\"l\" alignment=\"center\" theme=\"day\">\n\n        \n\n        \n\n        \n\n        \n\n        \n        \n            \n                \n                \n                    \n\n  \n  \n\n  \n\n  <h1 slot=\"heading-block__heading-text\">\n\n    \n      \n        \n  \n    \n    \n\n\n\n  \n\n\t\n    \n\t\t\n\t\t\n\t\t\t\n\t\t\n\n    \n    \n      \n\n      \n        Hi there, welcome to Microsoft\n      \n    \n\t\n\n  \n\n      \n    \n\n    \n  </h1>\n\n\n                \n            \n        \n\n        \n\n        \n\n        \n    </store-heading-block>\n\n    \n    \n        \n  \n<script src=\"/echo/etc.clientlibs/store/clientlibs/clientlib-web-components/heading-block/v1.ACSHASHe85ab9f16e0c89058bfcc06737940fd1.min.js\" type=\"module\"></script>\n\n\n\n    \n\n\n    \n  </store-layout-column>\n\n\n    \n    \n\n    \n    \n\n    \n\n    \n\n    \n      \n        \n        \n          \n\n\n\n    \n\n\n\n    \n<link rel=\"stylesheet\" href=\"/echo/etc.clientlibs/core/wcm/components/tabs/v1/tabs/clientlibs/site.ACSHASHd54c23ba76bd8648119795790ae83779.min.css\" type=\"text/css\">\n\n\n\n\n\n\n    \n\n\n\n\n\n\n\n\n    \n    \n\n    \n\n    \n\n    \n    \n\n    <store-tabs class=\"cmp-tabs\" data-cmp-is=\"tabs\" disable-dropdown-label=\"true\" full-bleed control-position=\"bottom-start\" default-tab-index=\"0\" alignment=\"center\" configuration=\"selector\" animation-duration=\"medium-2\" animation-view=\"load\" animation-enter=\"slide-in-bottom\" data-oc=\"oc0053\" animation-delay=\"delay-0\" id=\"tabs-tab-pill-oc0053\" animation-iteration=\"