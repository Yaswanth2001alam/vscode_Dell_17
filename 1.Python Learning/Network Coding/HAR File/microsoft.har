ocument.body.appendChild(img);\\n  }\\n})();',language:\"javascript\"}}]},{id:\"RL79bd6434ecf5435ba6ce43509ca4da68\",name:\"Surface Pro for Business CoPilot Devices -\\xa0Microsoft.com\\xa0- Product Page3- Publicis\",events:[{modulePath:\"core/src/lib/events/pageBottom.js\",settings:{},ruleOrder:50}],conditions:[{modulePath:\"core/src/lib/conditions/path.js\",settings:{paths:[{value:\"/en-us/surface/business/surface-pro-11th-edition\",valueIsRegex:!0}]}}],actions:[{modulePath:\"core/src/lib/actions/customCode.js\",settings:{source:'const encodedURL = encodeURIComponent(window.location.href);\\n\\nfunction triggerEpsilon() {\\n    var random = Math.floor(Math.random() * 1000000000); // Generate a random number for cache busting\\n    var script = document.createElement(\\'script\\'); // Create a script element\\n    script.src = \"https://www.microsoft.com/en-us/tag_path/profile/visit/js/1_0?dtm_cid=85524&dtm_cmagic=a2b968&dtm_fid=9870&dtm_promo_id=100&dtmc_loc=\" + encodedURL + \"&cachebuster=\" + random;\\n    document.head.appendChild(script); // Append the script element to the document head\\n}\\n\\ntriggerEpsilon();',language:\"javascript\"}}]},{id:\"RL7d79c8419a9a418b8b1c73ae64a0c9e1\",name:\"DIGSHELL\",events:[{modulePath:\"core/src/lib/events/pageBottom.js\",settings:{},ruleOrder:45}],conditions:[{modulePath:\"core/src/lib/conditions/domain.js\",settings:{domains:[\"microsoft.com\"]}},{modulePath:\"core/src/lib/conditions/path.js\",settings:{paths:[{value:\"\\\\/p\\\\/\",valueIsRegex:!0},{value:\"\\\\/d\\\\/\",valueIsRegex:!0}]}}],actions:[{modulePath:\"core/src/lib/actions/customCode.js\",settings:{\n                source:'try\\n{\\n\\twindow.shell_Tracking = {\\n\\n\\t\\t_init: function () {\\n\\t\\t\\tshell_Tracking.hostname = window.location.hostname.replace(/\\\\.microsoft\\\\.com$/i, \\'\\');\\n\\t\\t\\tshell_Tracking.URI = window.location.pathname.toString();\\n\\t\\t\\t//setup page path dimensions\\n\\t\\t\\tshell_Tracking._getPath();\\n\\t\\t},\\n\